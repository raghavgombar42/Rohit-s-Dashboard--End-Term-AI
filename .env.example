# Copy to .env.local and fill in. Never commit real values.
GEMINI_API_KEY=            # one or more keys, comma-separated
GEMINI_MODEL=gemini-3.8-flash
SUPABASE_URL=              # https://<ref>.supabase.co
SUPABASE_SECRET_KEY=
DATABASE_URL=              # Supabase pooler URI (session :5432 locally, transaction :6543 on Vercel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HUNTER_API_KEY=
DASHBOARD_PASSWORD=
EMAIL_OVERRIDE_TO=         # safe-mode inbox; every draft is addressed here
CRON_SECRET=               # bearer secret for /api/cron/*
TOKEN_ENCRYPTION_KEY=      # 64 hex chars (32 bytes) for AES-256-GCM
